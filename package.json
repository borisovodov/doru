{
  "name": "doru",
  "version": "0.0.36",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @doru/desktop",
    "build": "npm run build --workspace @doru/desktop",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint --type-aware --fix .",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:nls": "node .github/scripts/check-nls.ts",
    "check:schemas": "node .github/scripts/check-schemas.ts",
    "check:notices": "node .github/scripts/check-notices.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "site:dev": "npm run dev --workspace @doru/website",
    "site:build": "npm run build --workspace @doru/website",
    "ui": "npm run storybook --workspace @doru/ui",
    "ui:build": "npm run build-storybook --workspace @doru/ui",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.1.0",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.3": true
  }
}
