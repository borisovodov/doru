{
  "name": "doru",
  "version": "0.0.35",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @doru/desktop",
    "build": "npm run build --workspace @doru/desktop",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:nls": "node .github/scripts/check-nls.ts",
    "check:schemas": "node .github/scripts/check-schemas.ts",
    "check:notices": "node .github/scripts/check-notices.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "site:dev": "npm run dev --workspace @doru/website",
    "site:build": "npm run build --workspace @doru/website",
    "ui": "npm run storybook --workspace @doru/ui",
    "ui:build": "npm run build-storybook --workspace @doru/ui",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.30.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.10.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.3": true
  }
}
