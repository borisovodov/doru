{
  "name": "doru",
  "version": "0.0.17",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @doru/desktop",
    "build": "npm run build --workspace @doru/desktop",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "check:nls": "node .github/scripts/check-nls.ts",
    "check:schemas": "node .github/scripts/check-schemas.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "site:dev": "npm run dev --workspace @doru/website",
    "site:build": "npm run build --workspace @doru/website",
    "postinstall": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.4",
    "jsonc-parser": "3.3.1",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "koffi@3.3.3": true
  }
}
