{
  "name": "@doru/desktop",
  "version": "0.0.15",
  "private": true,
  "type": "module",
  "productName": "Doru",
  "desktopName": "org.doru.doru",
  "description": "Dóru — local-first, MIT-licensed genealogy for the AI era. Your data stays on your machine.",
  "author": "Boris Ovodov <boris@ovodov.me>",
  "homepage": "https://github.com/borisovodov/doru",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "icon:mac": "node scripts/generate-mac-icon.ts",
    "package": "electron-vite build && electron-builder --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@doru/ai": "*",
    "@doru/core": "*",
    "@doru/features": "*",
    "@doru/platform": "*",
    "@doru/workbench": "*",
    "electron-log": "5.4.4",
    "jsonc-parser": "3.3.1",
    "koffi": "3.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "vite": "7.3.7"
  }
}
